# Environment Configuration Template
# Copia este archivo como .env y ajusta los valores según necesites

# Environment Configuration
# Valores posibles: development, qa, staging, production
# Si no se especifica, se detecta automáticamente desde la rama Git
ENVIRONMENT=qa

# API Configuration
# Si no se especifica, se usa la URL por defecto del ambiente
API_BASE_URL=https://paints-api.reachu.io/qa-api

# Mixpanel Configuration
MIXPANEL_TOKEN=570d806261b36af574266b6256137b0d

# Debug Configuration
DEBUG_MODE=true

# Cache Configuration (en segundos)
CACHE_TTL=1800
SYNC_INTERVAL=30

# Session Replay Configuration
SESSION_REPLAY_ENABLED=true
SESSION_REPLAY_SAMPLING_RATE=100

# Branch-specific URLs (para override automático)
# DEVELOPMENT_API_URL=https://paints-api.reachu.io/qa-api
# QA_API_URL=https://paints-api.reachu.io/qa-api
# STAGING_API_URL=https://staging-paints-api.reachu.io/api
# PRODUCTION_API_URL=https://paints-api.reachu.io/api
